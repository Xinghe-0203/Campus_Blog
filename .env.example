# ============================================
# 校园博客论坛系统 - 环境变量配置文件
# ============================================
# 使用方式：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改下方配置值为实际值
#   3. 项目启动时自动加载
#
# 【重要】.env 文件不会提交到 Git（已在 .gitignore 中）
# ============================================

# ==================== 数据库配置（必需） ====================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campus_blog
DB_USERNAME=root
DB_PASSWORD=your_password

# ==================== JWT 配置（必需） ====================
# JWT 密钥（生产环境请使用至少 32 位的随机字符串）
JWT_SECRET=your_secret_key_at_least_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==================== 服务配置 ====================
# 应用端口
SERVER_PORT=8825

# ==================== 邮件服务配置（用于密码找回） ====================
# 邮件发送服务器地址
MAIL_HOST=smtp.example.com
# 邮件发送端口（TLS 通常为 587，SSL 通常为 465）
MAIL_PORT=587
# 发送邮箱账号
MAIL_USERNAME=your_email@example.com
# 邮箱密码或授权码
MAIL_PASSWORD=your_email_password_or_api_key
# 发件人邮箱地址
MAIL_FROM=noreply@example.com

# ==================== CORS 配置（可选） ====================
# 允许的跨域来源，多个来源用逗号分隔
# 示例: http://localhost:3000,http://localhost:8825
# 【重要】生产环境请务必设置具体的域名，禁止使用 * 通配符
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8825

# ==================== 文件上传配置（可选） ====================
# 最大文件上传大小（字节），默认 524288000 (500MB)
UPLOAD_MAX_FILE_SIZE=524288000

# ==================== 缓存与环境验证配置（可选） ====================
# 是否启用环境变量验证（生产环境建议设为 true）
ENV_VALIDATION_ENABLED=true

# ==================== 其他可选配置 ====================
# MyBatis SQL 日志配置
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.stdout.StdOutImpl (开启SQL日志)
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.nologging.NoLoggingImpl (关闭SQL日志)

# 邮件健康检查（配置真实SMTP后设为 true 以启用）
# MAIL_HEALTH_ENABLED=true