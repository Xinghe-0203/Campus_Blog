# ==================== JWT 配置 ====================
# JWT 密钥（生产环境请使用至少 32 位的随机字符串）
JWT_SECRET=bXlTZWNyZXRLZXlGb3JDYW1wdXBCbG9nU3lzdGVtMjAyNFZlcnlMb25nQW5kU2VjdXJl
