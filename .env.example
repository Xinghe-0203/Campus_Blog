# ==================== MyBatis Plus SQL 日志（可选） ====================
# SQL 日志实现类：org.apache.ibatis.logging.stdout.StdOutImpl = 开启
#                 org.apache.ibatis.logging.nologging.NoLoggingImpl = 关闭
MYBATIS_SQL_LOG=org.apache.ibatis.logging.stdout.StdOutImpl
