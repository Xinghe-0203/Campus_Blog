# ============================================
# 校园博客论坛系统 - 环境变量配置文件
# ============================================
# 使用方式：
#   1. 复制此文件为 .env：cp .env.example .env
#   2. 修改下方配置值为实际值
#   3. 项目启动时自动加载
#
# 【重要】.env 文件不会提交到 Git（已在 .gitignore 中）
# ============================================

# ==================== 数据库配置（必需） ====================
DB_HOST=IP
DB_PORT=3306
DB_NAME=campus_blog
DB_USERNAME=campus_blog
DB_PASSWORD=your_database_password_here

# ==================== JWT 配置（必需） ====================
# JWT 密钥（生产环境请使用至少 32 位的随机字符串）
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ==================== 可选配置 ====================
# SERVER_PORT=80
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.stdout.StdOutImpl (开启SQL日志)
# MYBATIS_SQL_LOG=org.apache.ibatis.logging.nologging.NoLoggingImpl (关闭SQL日志)

# ==================== CORS 配置（可选） ====================
# 允许的跨域来源，多个来源用逗号分隔，支持通配符 *
# 示例: http://localhost:*,http://127.0.0.1:*,https://campus-blog.com
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
